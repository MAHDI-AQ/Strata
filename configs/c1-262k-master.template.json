{
  "exe": "./build/strata",
  "cwd": ".",
  "tokenizer": "/path/to/models/tokenizer",
  "model_name": "strata-master-262k",
  "gpu": [
    0,
    1
  ],
  "host": "127.0.0.1",
  "port": 8096,
  "env": {
    "STRATA_WATCHDOG_S": "180",
    "STRATA_STAGE_OVERLAP": "1",
    "STRATA_PREFILL_CHAIN": "1",
    "STRATA_AUX_WIDE": "1",
    "STRATA_PLE_PREFETCH": "1",
    "STRATA_MTP_FUSE_CHAIN": "1",
    "STRATA_DRAFT_WAVEFRONT": "1",
    "STRATA_MMQ_BLOB": "1",
    "STRATA_VERIFY_DEVICE_PLAN": "1",
    "STRATA_STAGE_OVERLAP_CROSSDEV": "1",
    "STRATA_BATCH_HEAD": "1"
  },
  "args": [
    "--pack",
    "/path/to/models/pack",
    "--native",
    "/path/to/models/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_XXS-00001-of-00002.gguf",
    "--ple-gguf",
    "/path/to/models/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_XXS-00002-of-00002.gguf",
    "--expert-cache",
    "auto",
    "--expert-profile",
    "./data/expert-profile.bin",
    "--prefill",
    "auto",
    "--spec",
    "2",
    "--mtp-max-t",
    "2",
    "--suffix-draft",
    "0",
    "--spec-min-p",
    "0.35",
    "--mtp",
    "/path/to/models/mtp",
    "--max-context",
    "262144",
    "--concurrency",
    "1",
    "--kv",
    "q4_0",
    "--layer-split",
    "27",
    "--split-device",
    "1",
    "--ple-row-cache",
    "320001536",
    "--vram-reserve-mib",
    "636",
    "--adapt-every",
    "0"
  ],
  "log": "./logs/engine-c1-262k.log",
  "sampling": {
    "temperature": 0.6,
    "top_p": 0.95,
    "min_p": 0.05
  }
}