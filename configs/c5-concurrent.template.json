{
  "exe": "./build/strata",
  "cwd": ".",
  "tokenizer": "/path/to/models/tokenizer",
  "model_name": "strata-coder-c5",
  "gpu": [
    0,
    1
  ],
  "host": "127.0.0.1",
  "port": 8096,
  "env": {
    "STRATA_NO_IQ512": "1",
    "STRATA_NO_IQ256": "1",
    "STRATA_NO_IQ4NL": "1",
    "STRATA_WATCHDOG_S": "120",
    "STRATA_CONCURRENT_PROFILE": "1",
    "STRATA_STAGE_OVERLAP": "1",
    "STRATA_PREFILL_CHAIN": "1",
    "STRATA_AUX_WIDE": "1",
    "STRATA_CONCURRENT_RETAIN": "1"
  },
  "args": [
    "--pack",
    "/path/to/models/pack",
    "--native",
    "/path/to/models/Qwen3.8-Flash-Next-GSQ-RCO-IQ1_M-00001-of-00002.gguf",
    "--ple-gguf",
    "/path/to/models/Qwen3.8-Flash-Next-GSQ-RCO-IQ1_M-00002-of-00002.gguf",
    "--expert-profile",
    "./data/expert-profile-coder.bin",
    "--expert-cache",
    "auto",
    "--prefill",
    "auto",
    "--spec",
    "4",
    "--spec-min-p",
    "0.5",
    "--mtp",
    "/path/to/models/mtp",
    "--max-context",
    "131072",
    "--concurrency",
    "5",
    "--batch-rows",
    "20",
    "--batch-graphs",
    "24",
    "--batch-padding",
    "1",
    "--batch-policy",
    "fair",
    "--concurrent-prefill",
    "2048",
    "--kv",
    "q4_0",
    "--layer-split",
    "24",
    "--split-device",
    "1",
    "--ple-row-cache",
    "320001536"
  ],
  "log": "./logs/engine-c5-concurrent.log",
  "sampling": {
    "temperature": 0.6,
    "top_p": 0.95,
    "min_p": 0.05
  }
}