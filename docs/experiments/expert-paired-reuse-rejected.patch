+// Interleave independent accumulators so inlined codecs can reuse their weight decode.
+// Each accumulator retains row_dot's lane ownership and floating-point operation order.
+template<int TY>
+__device__ __forceinline__ float2 row_dot_pair(const uint8_t* row, const block_q8_1* x0,
+                                               const block_q8_1* x1, int nb, int lane) {
+    using F = Fmt<TY>;
+    float a = 0.0f, b = 0.0f;
+    for (int k = lane; k < nb * F::ipb; k += 32) {
+        const int kbx = k / F::ipb, iqs = F::step * (k % F::ipb);
+        a += F::dot(row, x0 + kbx * (F::qk / 32), kbx, iqs);
+        b += F::dot(row, x1 + kbx * (F::qk / 32), kbx, iqs);
+    }
+    return make_float2(warp_sum(a), warp_sum(b));
+}
