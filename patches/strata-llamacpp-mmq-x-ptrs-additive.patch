+template <ggml_type type>
+void mul_mat_q_case_ptrs(ggml_backend_cuda_context & ctx, const mmq_args & args, cudaStream_t stream, const char * const * x_ptrs) {
+    if (args.nrows_x % 128 == 0) {
+        constexpr bool fallback = false;
+        mul_mat_q_switch_J_ptrs<type, fallback>(ctx, args, stream, x_ptrs);
+    } else {
+        constexpr bool fallback = true;
